#!/usr/bin/env python3
# Harbour <-> Muse command shim (MPL-2.0). Stdlib only.
#
# Muse (cloud) invokes a custom command from /etc/musegadget/commands.d/*.json:
#   exec: ["/usr/local/bin/harbour-muse-cmd", "<tool>"]   (tool = a Harbour Agent tool name)   params as JSON on stdin
# This forwards it to the running Harbour Shell over a user-only Unix socket
# and prints the JSON result. It holds no credentials; the Muse SDK token lives
# only in the musegadget service.
import json, os, socket, sys

def sock_path():
    p = os.environ.get("HARBOUR_MUSE_CMD_SOCK")
    if p:
        return p
    rt = os.environ.get("XDG_RUNTIME_DIR") or "/run/user/%d" % os.getuid()
    return os.path.join(rt, "harbour", "muse-cmd.sock")

def main():
    if len(sys.argv) != 2 or not sys.argv[1].replace("_", "").isalnum():
        print("usage: harbour-muse-cmd <tool>   (params as JSON on stdin)", file=sys.stderr)
        return 2
    raw = sys.stdin.read(65536)
    try:
        params = json.loads(raw) if raw.strip() else {}
    except ValueError:
        print("stdin is not JSON", file=sys.stderr)
        return 2
    req = {"command": "harbour." + sys.argv[1], "params": params}
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
            s.settimeout(58)  # a side-effect command waits for the confirmation card on the device
            s.connect(sock_path())
            s.sendall(json.dumps(req).encode() + b"\n")
            line = s.makefile("rb").readline()
        reply = json.loads(line)
    except (OSError, ValueError) as e:
        print("Harbour Shell is not reachable: %s" % type(e).__name__, file=sys.stderr)
        return 1
    if not reply.get("ok"):
        print(str(reply.get("error") or "failed"), file=sys.stderr)
        return 1
    res = reply.get("result")
    print(json.dumps(res if isinstance(res, dict) else {"result": res}))
    return 0

if __name__ == "__main__":
    sys.exit(main())
