# Ch.3 Settings pages. Opened from Home (selection on Settings): it lands inside Display.
# Esc goes to the sidebar (Root); Down moves through the sections, Return opens one, Esc comes back.
# MOCK: Wi-Fi/Bluetooth/battery are placeholders. DEVICE ONLY: real SSID/IP/battery show
# (privacy: mask before publishing, see memos/demo-video-plan.md section 6).
goto:Settings,wait:500
Return,wait:1200
# Display: brightness slider
Right,wait:500,Right,wait:500,Left,wait:500,Left,wait:500
Escape,wait:900
# Audio, Network, Bluetooth, Devices, System, Apps, Agent
Down,Return,wait:1500,Escape,wait:500
Down,Return,wait:1500,Escape,wait:500
Down,Return,wait:1500,Escape,wait:500
Down,Return,wait:1500,Escape,wait:500
Down,Return,wait:1800,Escape,wait:500
Down,Return,wait:1500,Escape,wait:500
Down,Return,wait:2000,Escape,wait:500
Up,Up,Up,Up,Up,Up,Up,wait:600
Escape,wait:1000
