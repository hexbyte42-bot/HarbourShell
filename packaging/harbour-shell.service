[Unit]
Description=Harbour Shell (replacement for APPLaunch)
# Starting either launcher stops the other. If Harbour keeps failing, systemd
# starts the official launcher instead (see OnFailure and the start limit below).
Conflicts=APPLaunch.service
# Harbour Launcher was this program's old name; never run both (install_user.sh removes the old unit).
Conflicts=harbour-launcher.service
After=pipewire-pulse.service
Wants=pipewire-pulse.service
OnFailure=APPLaunch.service
StartLimitIntervalSec=30
StartLimitBurst=3

[Service]
Type=simple
ExecStartPre=-/usr/bin/xdg-user-dirs-update
WorkingDirectory=/usr/share/harbour-shell
Environment=HARBOUR_FB=/dev/fb0
Environment=HARBOUR_ROOT=/usr/share/harbour-shell
ExecStart=/usr/share/harbour-shell/bin/harbour-shell
# A clean exit (switch to the official launcher) must not restart Harbour.
TimeoutStopSec=3
Restart=on-failure
RestartSec=1

[Install]
WantedBy=default.target
