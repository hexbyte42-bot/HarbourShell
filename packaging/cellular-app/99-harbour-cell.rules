# QDC507 (Quectel EC25-compatible USB identity 2c7c:0125 after the NVRAM
# rewrite): the AT command port is USB interface 02. Give it a stable name
# for harbour-celld. Verify against the device's existing rule when
# installing by hand; the modem must keep its rewritten identity
# (do NOT reflash stock EC25/EG25-G firmware, do NOT touch usbid/usbcfg).
SUBSYSTEM=="tty", ATTRS{idVendor}=="2c7c", ATTRS{idProduct}=="0125", ENV{ID_USB_INTERFACE_NUM}=="02", SYMLINK+="cell-at", MODE="0660", GROUP="dialout"
